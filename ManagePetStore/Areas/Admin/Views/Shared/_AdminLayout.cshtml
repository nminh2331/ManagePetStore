<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin PetStore AI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/cropper/cropper.min.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-wrapper">
        <!-- Sidebar -->
        <aside class="admin-sidebar">
            <a href="/" class="admin-logo" style="color: #f97316; font-size: 1.35rem; font-weight: 700; text-decoration: none; display: flex; align-items: center; gap: 10px; padding-left: 10px;">
                <i class="fa-solid fa-paw" style="color: #f97316; font-size: 1.5rem;"></i>
                <span>PetStore</span>
            </a>
            
            <nav class="admin-nav">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="admin-nav-item active">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                    Quản lý tài khoản
                </a>
            </nav>

            <div class="admin-sidebar-footer">
                <form id="sidebarLogoutForm" asp-area="Customer" asp-controller="Account" asp-action="Logout" method="post" class="d-none">
                    @Html.AntiForgeryToken()
                </form>
                <button onclick="document.getElementById('sidebarLogoutForm').submit();" class="admin-logout-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                    Đăng xuất
                </button>
            </div>
        </aside>

        <!-- Main Content Panel -->
        <main class="admin-content">
            <!-- Header -->
            <header class="admin-header">
                <div class="admin-search-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <input type="text" class="admin-search-input" placeholder="Tìm kiếm nhanh..." />
                </div>

                <div class="admin-user-info">
                    <a asp-area="Customer" asp-controller="Account" asp-action="Profile" class="d-flex align-items-center gap-3 text-decoration-none" style="color: inherit;">
                        <div class="admin-profile-greet">
                            <p class="admin-greet-name">@User.FindFirst("FullName")?.Value</p>
                            <p class="admin-greet-role">Quản trị viên</p>
                        </div>

                        <div class="admin-avatar">
                            @User.FindFirst("FullName")?.Value.Substring(0, 1).ToUpper()
                        </div>
                    </a>
                </div>
            </header>

            <!-- Body -->
            <section class="admin-body-content">
                @RenderBody()
            </section>
        </main>
    </div>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/cropper/cropper.min.js" asp-append-version="true"></script>
    <script src="~/js/image-cropper.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
