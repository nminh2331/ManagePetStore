<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PetStore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/datetime24.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- Google Fonts Outfit Import for Premium Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* Custom overrides for Service Staff panel to match Mockup perfectly */
        :root {
            --primary-orange: #FF7815;
            --primary-orange-hover: #E0630D;
            --bg-body: #FAF8F6; /* Enhanced warm background */
            --sidebar-width: 260px;
            --text-dark: #2D2521;
            --text-muted: #9E918B;
            --border-light: #ECE9E5; /* cleaner border */
            --card-shadow: 0 10px 40px rgba(45, 37, 33, 0.03);
            --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body.service-body {
            font-family: 'Outfit', sans-serif;
            background-color: var(--bg-body);
            color: var(--text-dark);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        .service-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar layout styling with glass effect */
        .service-sidebar {
            width: var(--sidebar-width);
            background-color: #FFFFFF;
            border-right: 1px solid var(--border-light);
            display: flex;
            flex-direction: column;
            padding: 25px 18px;
            position: fixed;
            height: 100vh;
            left: 0;
            top: 0;
            z-index: 100;
            box-shadow: 4px 0 25px rgba(45, 37, 33, 0.015);
        }

        .service-logo {
            font-size: 1.35rem;
            font-weight: 700;
            color: var(--primary-orange);
            text-decoration: none;
            margin-bottom: 35px;
            display: flex;
            align-items: center;
            gap: 10px;
            padding-left: 10px;
            transition: var(--transition-smooth);
        }

        .service-logo:hover {
            opacity: 0.85;
            transform: scale(1.02);
            color: var(--primary-orange);
        }

        .service-logo i {
            font-size: 1.5rem;
        }

        .service-nav {
            display: flex;
            flex-direction: column;
            gap: 8px;
            flex-grow: 1;
        }

        .service-nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border-radius: 14px;
            color: var(--text-dark);
            text-decoration: none;
            font-weight: 500;
            font-size: 0.9rem;
            transition: var(--transition-smooth);
            border: 1px solid transparent;
        }

        .service-nav-item i {
            width: 20px;
            font-size: 1.05rem;
            color: var(--text-muted);
            transition: var(--transition-smooth);
        }

        .service-nav-item:hover {
            background-color: #FFF2E6;
            color: var(--primary-orange);
            transform: translateX(4px);
            border-color: rgba(255, 120, 21, 0.1);
        }

        .service-nav-item:hover i {
            color: var(--primary-orange);
        }

        .service-nav-item.active {
            background-color: var(--primary-orange);
            color: #FFFFFF;
            font-weight: 600;
            box-shadow: 0 6px 20px rgba(255, 120, 21, 0.25);
            border-color: var(--primary-orange);
        }

        .service-nav-item.active i {
            color: #FFFFFF;
        }

        .service-sidebar-footer {
            border-top: 1px solid var(--border-light);
            padding-top: 18px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .branch-info {
            background-color: #FFF9F5;
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 0.75rem;
            color: var(--text-dark);
        }

        .branch-title {
            font-weight: 600;
            color: var(--text-muted);
            margin: 0;
            text-transform: uppercase;
            font-size: 0.65rem;
            letter-spacing: 0.5px;
        }

        .branch-name {
            font-weight: 700;
            color: var(--primary-orange);
            margin: 2px 0 0 0;
        }

        .service-logout-btn {
            display: flex;
            align-items: center;
            gap: 12px;
            width: 100%;
            padding: 12px 16px;
            border: none;
            background: none;
            color: #EC5959;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            border-radius: 12px;
            transition: all 0.25s;
            text-align: left;
        }

        .service-logout-btn:hover {
            background-color: #FFF2F2;
        }

        /* Main Dashboard Content Layout */
        .service-content {
            margin-left: var(--sidebar-width);
            flex-grow: 1;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Header styling */
        .service-header {
            height: 70px;
            background-color: #FFFFFF;
            border-bottom: 1px solid var(--border-light);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 40px;
            position: sticky;
            top: 0;
            z-index: 90;
        }

        .search-box-wrapper {
            position: relative;
            max-width: 340px;
            width: 100%;
        }

        .search-box-wrapper i {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        .search-box-input {
            width: 100%;
            padding: 10px 16px 10px 44px;
            border-radius: 20px;
            border: 1px solid var(--border-light);
            background-color: #FDFDFD;
            font-size: 0.85rem;
            transition: all 0.25s;
        }

        .search-box-input:focus {
            outline: none;
            border-color: var(--primary-orange);
            background-color: #FFFFFF;
            box-shadow: 0 0 0 3px rgba(255, 120, 21, 0.08);
        }

        .user-panel {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .bell-icon-btn {
            border: none;
            background: none;
            color: var(--text-dark);
            padding: 8px;
            cursor: pointer;
            position: relative;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.25s;
        }

        .bell-icon-btn:hover {
            background-color: #F7F5F3;
        }

        .bell-dot-indicator {
            position: absolute;
            top: 10px;
            right: 10px;
            width: 6px;
            height: 6px;
            background-color: var(--primary-orange);
            border-radius: 50%;
        }

        .user-profile-link {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: inherit;
        }

        .user-greet-details {
            text-align: right;
        }

        .user-fullname-text {
            font-weight: 600;
            font-size: 0.85rem;
            margin: 0;
            color: var(--text-dark);
        }

        .user-role-label {
            font-size: 0.72rem;
            color: var(--text-muted);
            margin: 1px 0 0 0;
            font-weight: 500;
        }

        .user-circle-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, #FFE8DB 0%, #FFDCD0 100%);
            color: var(--primary-orange);
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: 700;
            font-size: 1.1rem;
            border: 1px solid #FFE3D5;
        }

        .service-body-container {
            padding: 30px 40px;
            background-color: var(--bg-body);
            flex-grow: 1;
        }

        .toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1000;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)

</head>
<body class="service-body">
    <div class="service-wrapper">
        <!-- Sidebar -->
        <aside class="service-sidebar">
            <a href="/SpaServices" class="service-logo">
                <i class="fa-solid fa-paw"></i>
                <span>PetStore</span>
            </a>
            
            <nav class="service-nav">
                @{
                    var servicePath = Context.Request.Path.Value ?? "";
                    bool isHotelWorkspace = servicePath.StartsWith("/SpaServices/Reception", StringComparison.OrdinalIgnoreCase) ||
                                             servicePath.StartsWith("/SpaServices/PetCheckIn", StringComparison.OrdinalIgnoreCase) ||
                                            servicePath.StartsWith("/SpaServices/CageMap", StringComparison.OrdinalIgnoreCase) ||
                                            servicePath.StartsWith("/SpaServices/CageCategories", StringComparison.OrdinalIgnoreCase);
                    bool isMedicalRecords = servicePath.StartsWith("/SpaServices/MedicalRecords", StringComparison.OrdinalIgnoreCase);
                    bool isHotelHistory = servicePath.StartsWith("/SpaServices/HotelHistory", StringComparison.OrdinalIgnoreCase);
                    bool isDailyCare = servicePath.StartsWith("/SpaServices/PetDaily", StringComparison.OrdinalIgnoreCase);
                }
                <a href="/SpaServices" class="service-nav-item @(!isHotelWorkspace && !isMedicalRecords && (servicePath == "/SpaServices" || servicePath == "/SpaServices/Index" || servicePath == "/SpaServices/") ? "active" : "")">
                    <i class="fa-solid fa-scissors"></i>
                    Dịch vụ Spa
                </a>
                <a href="/SpaServices/MedicalRecords" class="service-nav-item @(isMedicalRecords ? "active" : "")">
                    <i class="fa-solid fa-book-medical"></i>
                    Sổ y tế
                </a>
                <a href="/SpaServices/Reception" class="service-nav-item @((servicePath.StartsWith("/SpaServices/Reception", StringComparison.OrdinalIgnoreCase) || servicePath.StartsWith("/SpaServices/PetCheckIn", StringComparison.OrdinalIgnoreCase)) ? "active" : "")">
                    <i class="fa-solid fa-clipboard-check"></i>
                    Tiếp nhận
                </a>
                <a href="/SpaServices/CageMap" class="service-nav-item @(!isHotelHistory && (servicePath.StartsWith("/SpaServices/CageMap", StringComparison.OrdinalIgnoreCase) || servicePath.StartsWith("/SpaServices/Hotel", StringComparison.OrdinalIgnoreCase)) ? "active" : "")">
                    <i class="fa-solid fa-map-location-dot"></i>
                    Sơ đồ Chuồng
                </a>
                <a href="/SpaServices/CageCategories" class="service-nav-item @(servicePath.StartsWith("/SpaServices/CageCategories", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                    <i class="fa-solid fa-house-chimney-medical"></i>
                    Danh mục Chuồng
                </a>
                <a href="/SpaServices/PetDaily" class="service-nav-item @(isDailyCare ? "active" : "")">
                    <i class="fa-solid fa-book-open"></i>
                    Nhật ký chăm sóc
                </a>
                <a href="/SpaServices/HotelHistory" class="service-nav-item @(isHotelHistory ? "active" : "")">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                    Lịch sử lưu trú
                </a>
            </nav>

            <div class="service-sidebar-footer">
                <div class="branch-info">
                    <p class="branch-title">Cửa hàng PET</p>
                    <p class="branch-name">Nhân viên</p>
                </div>
                
                <form id="sidebarLogoutForm" asp-area="Customer" asp-controller="Account" asp-action="Logout" method="post" class="d-none">
                    @Html.AntiForgeryToken()
                </form>
                <button onclick="document.getElementById('sidebarLogoutForm').submit();" class="service-logout-btn">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    Đăng xuất
                </button>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="service-content">
            <!-- Header -->
            <header class="service-header">
                <div class="search-box-wrapper">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" class="search-box-input" placeholder="Tìm kiếm nhanh..." />
                </div>

                <div class="user-panel" style="position: relative;">
                    <button class="bell-icon-btn" id="staffBellBtn" type="button" title="Xem thông báo">
                        <i class="fa-regular fa-bell"></i>
                        <span class="bell-dot-indicator" id="staffBellDot" style="display: none; background-color: #EC5959;"></span>
                        <span id="staffBellBadge" class="badge rounded-pill bg-danger" style="display: none; position: absolute; top: -2px; right: -2px; font-size: 0.65rem; padding: 2px 6px;">0</span>
                    </button>

                    <!-- Staff Notification Dropdown Menu -->
                    <div id="staffNotiDropdown" style="display: none; position: absolute; top: 50px; right: 0; width: 360px; background: #FFFFFF; border-radius: 14px; border: 1px solid #ECE9E5; box-shadow: 0 10px 30px rgba(0,0,0,0.12); z-index: 9999; overflow: hidden;">
                        <div style="padding: 14px 18px; background: #FAFAFA; border-bottom: 1px solid #ECE9E5; display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-weight: 800; font-size: 0.9rem; color: #2D2521;">
                                <i class="fa-solid fa-bell text-warning me-1"></i> Thông báo từ khách hàng
                            </span>
                            <span id="staffNotiUnreadBadge" style="font-size: 0.75rem; background: #FFF2E8; color: #FF7815; font-weight: 700; padding: 3px 8px; border-radius: 8px;">0 chưa đọc</span>
                        </div>
                        <div id="staffNotiList" style="max-height: 340px; overflow-y: auto; padding: 6px 0;">
                            <!-- Dynamic Items -->
                        </div>
                        <div style="padding: 10px; text-align: center; background: #FAFAFA; border-top: 1px solid #ECE9E5;">
                            <button id="btnClearStaffNoti" type="button" style="border: none; background: none; color: #FF7815; font-size: 0.8rem; font-weight: 700; cursor: pointer;">
                                <i class="fa-solid fa-check-double me-1"></i> Đánh dấu tất cả đã đọc
                            </button>
                        </div>
                    </div>
                    
                    <a asp-area="Customer" asp-controller="Account" asp-action="Profile" class="user-profile-link">
                        <div class="user-greet-details">
                            <p class="user-fullname-text">@User.FindFirst("FullName")?.Value</p>
                            <p class="user-role-label">Nhân viên Chăm sóc</p>
                        </div>
                        <div class="user-circle-avatar">
                            @User.FindFirst("FullName")?.Value.Substring(0, 1).ToUpper()
                        </div>
                    </a>
                </div>
            </header>

            <!-- Body -->
            <section class="service-body-container">
                @RenderBody()
            </section>
        </main>
    </div>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/signalr.min.js"></script>
    <script src="~/js/datetime24.js" asp-append-version="true"></script>

    <script>
        (function () {
            const STORAGE_KEY = 'staff_spa_notifications_v1';

            function getNotifications() {
                try {
                    return JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
                } catch(e) {
                    return [];
                }
            }

            function saveNotifications(list) {
                try {
                    localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
                } catch(e) {}
            }

            function renderNotifications() {
                const list = getNotifications();
                const unreadCount = list.filter(n => !n.read).length;

                const bellDot = document.getElementById('staffBellDot');
                const bellBadge = document.getElementById('staffBellBadge');
                const unreadBadge = document.getElementById('staffNotiUnreadBadge');
                const notiList = document.getElementById('staffNotiList');

                if (unreadCount > 0) {
                    if (bellDot) bellDot.style.display = 'block';
                    if (bellBadge) {
                        bellBadge.style.display = 'inline-block';
                        bellBadge.textContent = unreadCount > 9 ? '9+' : unreadCount;
                    }
                    if (unreadBadge) unreadBadge.textContent = unreadCount + ' chưa đọc';
                } else {
                    if (bellDot) bellDot.style.display = 'none';
                    if (bellBadge) bellBadge.style.display = 'none';
                    if (unreadBadge) unreadBadge.textContent = '0 chưa đọc';
                }

                if (!notiList) return;

                if (list.length === 0) {
                    notiList.innerHTML = '<div style="padding: 30px 20px; text-align: center; color: #a0aec0; font-size: 0.85rem;">' +
                        '<i class="fa-regular fa-bell-slash" style="font-size: 1.8rem; margin-bottom: 8px; display: block; color: #cbd5e0;"></i>' +
                        'Chưa có thông báo nào</div>';
                    return;
                }

                let html = '';
                list.forEach(function (n) {
                    const bgStyle = n.read ? '#ffffff' : '#FFF9F5';
                    const borderStyle = n.read ? '1px solid #F0F0F0' : '1.5px solid #FFD8BF';
                    
                    html += '<div class="staff-noti-item" style="padding: 12px 16px; border-bottom: ' + borderStyle + '; background: ' + bgStyle + '; cursor: pointer; transition: background 0.2s;">' +
                        '<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 4px;">' +
                            '<span style="font-weight: 800; font-size: 0.84rem; color: #C53030; display: flex; align-items: center; gap: 6px;">' +
                                '<i class="fa-solid fa-circle-exclamation"></i> Hủy Lịch Spa' +
                            '</span>' +
                            '<span style="font-size: 0.72rem; color: #a0aec0;">' + (n.createdAt || '') + '</span>' +
                        '</div>' +
                        '<div style="font-size: 0.83rem; color: #2D2521; line-height: 1.4;">' +
                            '<strong>' + (n.customerName || 'Khách') + '</strong> vừa hủy ca Spa <strong>' + (n.serviceName || '') + '</strong> cho bé <strong>' + (n.petName || '') + '</strong>' +
                        '</div>' +
                        '<div style="font-size: 0.78rem; color: #E53E3E; margin-top: 4px; background: #FFF0F0; padding: 4px 8px; border-radius: 6px;">' +
                            '💬 Lý do: ' + (n.reason || 'Không có') +
                        '</div>' +
                    '</div>';
                });

                notiList.innerHTML = html;
            }

            // Bell button toggle
            const bellBtn = document.getElementById('staffBellBtn');
            const dropdown = document.getElementById('staffNotiDropdown');

            if (bellBtn && dropdown) {
                bellBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    const isVisible = dropdown.style.display === 'block';
                    dropdown.style.display = isVisible ? 'none' : 'block';
                    if (!isVisible) {
                        renderNotifications();
                    }
                });

                document.addEventListener('click', function (e) {
                    if (!dropdown.contains(e.target) && !bellBtn.contains(e.target)) {
                        dropdown.style.display = 'none';
                    }
                });
            }

            // Clear all read
            const btnClear = document.getElementById('btnClearStaffNoti');
            if (btnClear) {
                btnClear.addEventListener('click', function () {
                    const list = getNotifications();
                    list.forEach(n => n.read = true);
                    saveNotifications(list);
                    renderNotifications();
                });
            }

            // Render initially on page load
            renderNotifications();

            // SignalR Connection
            if (typeof signalR === 'undefined') return;

            var connection = new signalR.HubConnectionBuilder()
                .withUrl("/reviewHub")
                .withAutomaticReconnect()
                .build();

            connection.start().then(function () {
                console.log("Staff SignalR Connected successfully!");
                connection.invoke("JoinStaffGroup").catch(function(err) {
                    console.error("Error joining StaffGroup:", err);
                });
            }).catch(function (err) {
                console.error("Staff SignalR Connection Error:", err);
            });

            function playAlertBeep() {
                try {
                    var audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                    var osc = audioCtx.createOscillator();
                    var gain = audioCtx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(587.33, audioCtx.currentTime);
                    osc.frequency.setValueAtTime(880, audioCtx.currentTime + 0.15);
                    gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.45);
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.45);
                } catch (e) {}
            }

            connection.on("ReceiveSpaCancellationNotification", function (data) {
                playAlertBeep();

                // Store in local notification list
                const list = getNotifications();
                const timeStr = new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
                list.unshift({
                    id: Date.now(),
                    customerName: data.customerName,
                    serviceName: data.serviceName,
                    petName: data.petName,
                    bookingDate: data.bookingDate,
                    reason: data.reason,
                    createdAt: timeStr,
                    read: false
                });

                if (list.length > 20) list.pop();
                saveNotifications(list);
                renderNotifications();
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
